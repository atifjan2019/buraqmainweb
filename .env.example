# Burraq Motors CRM — the source of truth for stock and the destination for
# enquiries. Copy this file to `.env.local` and fill in the key.
#
# Neither variable is prefixed NEXT_PUBLIC_, and the key must never gain that
# prefix: it authenticates writes into the dealership's sales pipeline, so
# exposing it to the browser would let anyone post junk leads to the sales team.
# `lib/crm.ts` imports `server-only` to make that mistake a build error.

CRM_API_URL=https://crm.burraqmotors.co.uk/api/v1

# Generate/copy from the CRM: Backend → API & Documentation.
# Stock listings are public and read fine without it; only enquiries need it.
FRONTEND_API_KEY=
